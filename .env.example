# AI Configuration - Option A (AI-powered)
# Use OPENAI_API_KEY, OPENROUTER_API_KEY, OLLAMA_URL, or leave empty for mock data

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# OpenRouter API key (https://openrouter.ai/keys)
# Provides access to multiple models (GPT-4, Claude, Llama, etc.)
OPENROUTER_API_KEY=

# Ollama connection (local, free - http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# No keys needed for Option B (template-based)